<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground">

    <!-- Stats Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_pill_blue"
            android:padding="10dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:id="@+id/tvNavQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorPrimaryLight"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAV"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="9sp"
                android:letterSpacing="0.1"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_pill_green"
            android:padding="10dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:id="@+id/tvScannedQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorPositive"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCANNED"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="9sp"
                android:letterSpacing="0.1"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_pill_red"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvVariance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorNegative"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VARIANCE"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="9sp"
                android:letterSpacing="0.1"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Rack & Location Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RACK"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>

        <EditText
            android:id="@+id/etRack"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:inputType="number"
            android:text="1"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/bg_input_field"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCATION"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <Spinner
                android:id="@+id/spinnerLocation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorBorder"/>

    <!-- Search -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:queryHint="Search barcode or description..."
        app:iconifiedByDefault="false"
        app:queryBackground="@null"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorBorder"/>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimaryLight"
        android:visibility="gone"/>

    <!-- List + empty state -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInventory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"/>

        <LinearLayout
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:visibility="gone"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <!-- Dashed icon container -->
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:background="@drawable/bg_empty_state_icon"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_import"
                    app:tint="?attr/colorTextSecondary"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Inventory Data"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap IMPORT to load the NAV product list for this store and cut-off date."
                android:textColor="?attr/colorTextSecondary"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"/>

            <!-- IMPORT hint pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_import"
                    app:tint="?attr/colorPrimaryLight"
                    android:layout_marginEnd="7dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use the IMPORT button below"
                    android:textColor="?attr/colorPrimaryLight"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Decorative dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_empty_dot"
                    android:layout_marginEnd="6dp"/>

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_empty_dot"
                    android:layout_marginEnd="6dp"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_empty_dot"/>
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/colorSurface">

        <Button
            android:id="@+id/btnClearScans"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_button_danger"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="IMPORT"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="SCAN"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_button_primary"/>
    </LinearLayout>
</LinearLayout>
