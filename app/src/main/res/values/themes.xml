<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ====================================================
         MINIMALIST THEME (B&W) — DEFAULT
         ==================================================== -->
    <style name="Theme.RGMCInventory" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Material standard -->
        <item name="colorPrimary">@color/min_primary</item>
        <item name="colorPrimaryDark">@color/min_primaryDark</item>
        <item name="colorAccent">@color/min_accent</item>
        <item name="colorSurface">@color/min_surface</item>
