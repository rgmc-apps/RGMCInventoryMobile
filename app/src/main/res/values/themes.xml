    <!-- ====================================================
         SHARED COMPONENT STYLES
         ==================================================== -->

    <style name="Widget.RGMC.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.RGMC.ActionBarTitle</item>
    </style>

    <style name="ThemeOverlay.RGMC.ActionBar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="colorControlNormal">?attr/colorTextSecondary</item>
    </style>

    <style name="ThemeOverlay.RGMC.ActionBar.Dark" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="colorControlNormal">?attr/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.RGMC.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Widget.RGMC.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.RGMC.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@null</item>
        <item name="android:popupBackground">?attr/colorSurfaceVariant</item>
    </style>

    <style name="Widget.RGMC.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.RGMC.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorBorder</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.RGMC.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorNegative</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="TextAppearance.RGMC.ScreenLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RGMC.StatValue" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RGMC.StatLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
