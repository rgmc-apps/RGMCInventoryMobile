    <!-- ====================================================
         SPLASH THEMES
         ==================================================== -->
    <style name="Theme.RGMCInventory.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/min_background</item>
        <item name="android:statusBarColor">@color/min_background</item>
        <item name="android:navigationBarColor">@color/min_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorTextPrimary">@color/min_textPrimary</item>
        <item name="colorTextSecondary">@color/min_textSecondary</item>
        <item name="colorTextMuted">@color/min_textMuted</item>
        <item name="colorBorder">@color/min_border</item>
        <item name="colorDivider">@color/min_divider</item>
        <item name="colorPrimaryLight">@color/min_primaryLight</item>
    </style>

    <style name="Theme.RGMCInventory.Splash.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorTextPrimary">@color/light_textPrimary</item>
        <item name="colorTextSecondary">@color/light_textSecondary</item>
        <item name="colorTextMuted">@color/light_textMuted</item>
        <item name="colorBorder">@color/light_border</item>
        <item name="colorDivider">@color/light_divider</item>
        <item name="colorPrimaryLight">@color/light_primaryLight</item>
    </style>

    <style name="Theme.RGMCInventory.Splash.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorTextPrimary">@color/dark_textPrimary</item>
        <item name="colorTextSecondary">@color/dark_textSecondary</item>
        <item name="colorTextMuted">@color/dark_textMuted</item>
        <item name="colorBorder">@color/dark_border</item>
        <item name="colorDivider">@color/dark_divider</item>
