<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RGMCInventory" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorSurface</item>
        <item name="colorPrimaryDark">@color/colorBackground</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="actionBarStyle">@style/Widget.RGMC.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.RGMC.ActionBar</item>
        <item name="materialCardViewStyle">@style/Widget.RGMC.CardView</item>
        <item name="android:spinnerStyle">@style/Widget.RGMC.Spinner</item>
        <item name="android:dropDownSpinnerStyle">@style/Widget.RGMC.Spinner</item>
    </style>

    <style name="Theme.RGMCInventory.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ActionBar -->
    <style name="Widget.RGMC.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.RGMC.ActionBarTitle</item>
    </style>

    <style name="ThemeOverlay.RGMC.ActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="colorControlNormal">@color/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.RGMC.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Card -->
    <style name="Widget.RGMC.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Spinner -->
    <style name="Widget.RGMC.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@null</item>
        <item name="android:popupBackground">@color/colorSurfaceVariant</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.RGMC.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.RGMC.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorBorder</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.RGMC.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorNegative</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Text appearances (explicit parents to avoid implicit AAPT resolution) -->
    <style name="TextAppearance.RGMC.ScreenLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RGMC.StatValue" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RGMC.StatLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
