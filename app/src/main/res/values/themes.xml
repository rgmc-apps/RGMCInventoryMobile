        <item name="colorOnSurface">@color/min_textPrimary</item>
        <item name="colorOnBackground">@color/min_textPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Window -->
        <item name="android:windowBackground">@color/min_background</item>
        <item name="android:statusBarColor">@color/min_background</item>
        <item name="android:navigationBarColor">@color/min_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Custom RGMC attrs -->
        <item name="colorBorder">@color/min_border</item>
        <item name="colorDivider">@color/min_divider</item>
        <item name="colorSurfaceVariant">@color/min_surfaceVariant</item>
        <item name="colorTextPrimary">@color/min_textPrimary</item>
        <item name="colorTextSecondary">@color/min_textSecondary</item>
        <item name="colorTextMuted">@color/min_textMuted</item>
        <item name="colorPrimaryLight">@color/min_primaryLight</item>
        <item name="colorAccentLight">@color/min_accentLight</item>
        <item name="colorPositive">@color/min_positive</item>
        <item name="colorNegative">@color/min_negative</item>
        <item name="colorWarning">@color/min_warning</item>
        <item name="colorNeutral">@color/min_neutral</item>
        <item name="colorModuleScanner">@color/min_moduleScanner</item>
        <item name="colorModuleSessions">@color/min_moduleSessions</item>
        <item name="colorModuleProducts">@color/min_moduleProducts</item>
        <item name="colorModuleNotes">@color/min_moduleNotes</item>
        <item name="colorModuleSigning">@color/min_moduleSigning</item>
        <item name="colorModuleExport">@color/min_moduleExport</item>
        <item name="colorModuleUpdate">@color/min_moduleUpdate</item>
        <item name="colorModuleCutoffs">@color/min_moduleCutoffs</item>
        <item name="colorVariancePositive">@color/min_variancePositive</item>
        <item name="colorVarianceNegative">@color/min_varianceNegative</item>
        <item name="colorVarianceZero">@color/min_varianceZero</item>
        <!-- Styles -->
        <item name="actionBarStyle">@style/Widget.RGMC.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.RGMC.ActionBar</item>
        <item name="materialCardViewStyle">@style/Widget.RGMC.CardView</item>
        <item name="android:spinnerStyle">@style/Widget.RGMC.Spinner</item>
        <item name="android:dropDownSpinnerStyle">@style/Widget.RGMC.Spinner</item>
    </style>

